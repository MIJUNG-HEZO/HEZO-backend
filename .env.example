APP_ENV=local
APP_NAME=HEZO API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://hezo_user:hezo_password@localhost:5432/hezo_mvp

JWT_SECRET_KEY=change-me
